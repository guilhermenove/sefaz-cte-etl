# Copie para .env e preencha. O .env NUNCA deve ir para o Git.

# CNPJ do tomador consultado na SEFAZ (só números)
CNPJ_CONSULTADO=00000000000000

# Código IBGE da UF do autor (41=PR, 35=SP...)
CUF_AUTOR=41

# Certificado A1 na mesma pasta do script
CERT_ARQUIVO=certificado.pfx
# Senha do certificado (opcional: se vazio, o script pergunta na hora)
CERT_SENHA=

# Google Sheets (conta de serviço com acesso de edição à planilha)
GOOGLE_CREDENCIAIS=credenciais_google.json
PLANILHA_URL_OU_ID=
ABA_SAIDAS=Detalhado Saídas
